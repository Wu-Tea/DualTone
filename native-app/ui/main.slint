import { ScrollView, AboutSlint, Palette } from "std-widgets.slint";
import { Theme, Row, Label, Muted, Foundation, Surface, Divider, Action, Check, Fader, NumEdit, Picker, Meter, TitleBar } from "controls.slint";
export { Theme } from "controls.slint";
export struct BandRow { low: string, high: string, gain: string, enabled: bool }
export struct EqPoint { frequency: string, gain: float, value: string, position: float }
export global UiData {
    in-out property <bool> dark <=> Theme.dark;
    in-out property <bool> active: false;
    in-out property <bool> paused: false;
    in-out property <bool> eq-on: true;
    in-out property <bool> band-on: true;
    in-out property <float> gain: 8;
    in-out property <bool> sync-mode: false;
    in-out property <float> main-delay: 0;
    in-out property <float> max-delay: 1000;
    in-out property <int> input-index: 0;
    in-out property <string> sync-status: "";
    in-out property <bool> reverb: false;
    in-out property <float> reverb-size: 40;
    in-out property <float> reverb-decay: 1.2;
    in-out property <float> reverb-brightness: 40;
    in-out property <float> body: 44;
    in-out property <float> minimum-body: 25.1189;
    in-out property <float> input-level: 0;
    in-out property <float> output-level: 0;
    in-out property <string> status: "已停止";
    in-out property <string> queue: "队列 0.0 ms";
    in-out property <string> issue: "";
    in-out property <string> headroom: "余量 1.0 dB";
    in-out property <[string]> device-labels;
    in-out property <int> source-index: 0;
    in-out property <int> target-index: 0;
    in-out property <image> source-icon;
    in-out property <image> target-icon;
    in-out property <image> logo: @image-url("assets/dualtone-icon.png");
    in-out property <image> sliders-icon;
    in-out property <[string]> presets;
    in-out property <int> preset-index: -1;
    in-out property <string> preset-placeholder: "尚无预设";
    in-out property <[BandRow]> bands;
    in-out property <[EqPoint]> eq-points;
    in-out property <image> chart;
    in-out property <image> mini-chart;
    in-out property <string> dialog-title;
    in-out property <string> dialog-text;
    in-out property <bool> dialog-input: false;
    in-out property <int> managed-preset: -1;
    in-out property <string> theme-mode: "dark";
    in-out property <string> dialog-confirm: "close-info";
    in-out property <string> dialog-button: "关闭";
    in-out property <bool> dialog-danger: false;
    in-out property <bool> caption-max-hover: false;
    callback window-action(string, string);
    callback action(string, string);
    callback setting(string, string);
    callback band-edit(int, string, string);
    callback eq-edit(int, float);
}

component Presets inherits Picker {
    model: UiData.presets;current-index: UiData.preset-index;
    placeholder: UiData.preset-placeholder;label: "声音预设";
    selected(value) => {UiData.action("preset",value);}
}
component ParameterRow inherits Row {
    in property <string> caption;
    in property <string> setting;
    in property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <string> unit: "%";
    callback edited(float);
    height: 36px;spacing: 10px;
    Label {text: root.caption;width: 62px;}
    Fader {value: root.value;minimum: root.minimum;maximum: root.maximum;step: root.step;label: root.caption;horizontal-stretch: 1;edited(v) => {root.edited(v);}}
    NumEdit {value: "\{round(root.value*10)/10}";unit: root.unit;label: root.caption;width: 78px;submitted(v) => {UiData.setting(root.setting,v);}}
}
component Legend inherits Row {
    in property <string> caption;in property <color> ink;in property <bool> dashed: false;
    width: 96px;spacing: 6px;
    Rectangle {width: 12px;height: 2px;background: root.ink;
        if root.dashed: Rectangle {x: 4px;width: 3px;height: 2px;background: Theme.plot;}
    }
    Muted {text: root.caption;}
}
component AppMenu inherits Action {
    text: "•••";min-width: 36px;
    clicked => {menu.show();}
    menu := PopupWindow {width: 252px;height: 232px;y: 40px;
        Surface {width: parent.width;height: parent.height;
            VerticalLayout {padding: 12px;spacing: 8px;
                Muted {text: "外观";height: 18px;}
                Row {height: 36px;spacing: 4px;
                    Action {text: "深色";min-width: 64px;selected: UiData.theme-mode=="dark";clicked => {UiData.action("theme","dark");}}
                    Action {text: "浅色";min-width: 64px;selected: UiData.theme-mode=="light";clicked => {UiData.action("theme","light");}}
                    Action {text: "自动";min-width: 64px;selected: UiData.theme-mode=="system";clicked => {UiData.action("theme","system");}}
                }
                Divider {}
                Action {text: "诊断…";clicked => {menu.close();UiData.action("diagnostics","");}}
                Action {text: "关于 DualTone";clicked => {menu.close();UiData.action("about","");}}
                Action {text: "收至托盘";clicked => {menu.close();UiData.action("tray","");}}
            }
        }
    }
}
export component MainWindow inherits Window {
    title: "DualTone";preferred-width: 460px;preferred-height: 590px;min-width: 420px;min-height: 590px;
    default-font-family: "Microsoft YaHei UI";default-font-size: Theme.font;
    in-out property <ColorScheme> scheme <=> Palette.color-scheme;
    Foundation {width: parent.width;height: parent.height;}
    TitleBar {x: 0px;y: 0px;width: parent.width;caption: "";maximized: root.maximized;max-hover: UiData.caption-max-hover;command(kind) => {UiData.window-action("main",kind);}}
    VerticalLayout {y: Theme.caption-height;width: parent.width;height: parent.height - Theme.caption-height;padding: Theme.page-inset;spacing: 14px;
        Row {height: 38px;spacing: 10px;
            Image {source: UiData.logo;width: 30px;height: 30px;}
            Label {text: "DualTone";font-size: 22px;font-weight: 600;horizontal-stretch: 1;}
            Muted {text: UiData.status;color: UiData.active ? Theme.success : Theme.muted;}
            Action {text: UiData.active ? "停止" : "开始";primary: !UiData.active;filled: UiData.active;min-width: 66px;clicked => {UiData.action("toggle","");}}
            AppMenu {}
        }
                Surface {height: 168px;
                    VerticalLayout {padding: 16px;spacing: 10px;
                        Row {height: 58px;spacing: 12px;
                            Image {source: UiData.source-icon;width: 24px;height: 24px;}
                            VerticalLayout {spacing: 4px;
                                Row {height: 18px;Muted {text: "主音频";horizontal-stretch: 1;}Action {text: "交换";min-height: 18px;min-width: 48px;enabled: !UiData.active;clicked => {UiData.action("swap","");}}}
                                Picker {model: UiData.device-labels;current-index: UiData.source-index;enabled: !UiData.active;label: "主音频设备";selected(v) => {UiData.action("source",v);}}
                            }
                        }
                        Divider {}
                        Row {height: 58px;spacing: 12px;
                            Image {source: UiData.target-icon;width: 24px;height: 24px;}
                            VerticalLayout {spacing: 4px;
                                Row {height: 18px;Muted {text: "副音频";horizontal-stretch: 1;}Action {text: "刷新";min-height: 18px;min-width: 48px;clicked => {UiData.action("refresh","");}}}
                                Picker {model: UiData.device-labels;current-index: UiData.target-index;enabled: !UiData.active || !UiData.sync-mode;label: "副音频设备";selected(v) => {UiData.action("target",v);}}
                            }
                        }
                    }
                }

        Row {height: 36px;spacing: 8px;
            ParameterRow {caption: "副音量";setting: "gain";value: UiData.gain;step: 0.1;horizontal-stretch: 1;edited(v) => {UiData.setting("gain","\{v}");}}
            Action {text: UiData.paused ? "恢复" : "静音";selected: UiData.paused;min-width: 48px;clicked => {UiData.action("pause","");}}
        }
        Rectangle {height: 40px;background: Theme.field;border-radius: Theme.radius;
            Row {padding: 4px;spacing: 4px;
                Action {text: "空间补充";selected: !UiData.reverb;horizontal-stretch: 1;min-height: 32px;clicked => {UiData.setting("effect_mode","\"space\"");}}
                Action {text: "混响";selected: UiData.reverb;horizontal-stretch: 1;min-height: 32px;clicked => {UiData.setting("effect_mode","\"reverb\"");}}
            }
        }
        if !UiData.reverb: ParameterRow {caption: "中心声量";setting: "body";minimum: UiData.minimum-body;value: UiData.body;edited(v) => {UiData.setting("body","\{v}");}}
        if UiData.reverb: ParameterRow {caption: "尾音时长";setting: "reverb_decay";minimum: 0.2;maximum: 4;step: 0.1;unit: "s";value: UiData.reverb-decay;edited(v) => {UiData.setting("reverb_decay","\{round(v*10)/10}");}}
        Row {height: 36px;spacing: 8px;Presets {horizontal-stretch: 1;}Action {text: "管理";min-width: 48px;clicked => {UiData.action("presets","");}}}
        Divider {}
        Row {height: 36px;spacing: 8px;
            Action {text: "声音调节 ›";filled: true;horizontal-stretch: 1;clicked => {UiData.action("details","");}}

        }
        if UiData.issue!="": Text {text: UiData.issue;color: Theme.danger;font-size: Theme.small;wrap: word-wrap;max-height: 44px;}
    }
}
component EqPlot inherits Rectangle {
    background: Theme.plot;
    Image {source: UiData.chart;width: parent.width;height: parent.height;image-fit: fill;}
    for point[index] in UiData.eq-points: Rectangle {
        x: (38/900+point.position*830/900)*root.width - 7px;y: (24/300+(12 - point.gain)/48*252/300)*root.height - 7px;
        width: 14px;height: 14px;border-radius: 7px;background: Theme.plot;border-width: key.has-focus ? 3px : 2px;border-color: Theme.curve;
        accessible-role: slider;accessible-label: "\{point.frequency} Hz EQ";accessible-value: point.value;
        key := FocusScope {key-pressed(event) => {if event.text==Key.UpArrow || event.text==Key.RightArrow {UiData.eq-edit(index,min(12,point.gain+0.1));return accept;}if event.text==Key.DownArrow || event.text==Key.LeftArrow {UiData.eq-edit(index,max(-12,point.gain - 0.1));return accept;}return reject;}}
        hit := TouchArea {x: -7px;y: -7px;width: 28px;height: 28px;mouse-cursor: ns-resize;
            pointer-event(event) => {if event.kind==PointerEventKind.down {key.focus();}}
            moved => {if self.pressed {UiData.eq-edit(index,clamp(point.gain - (self.mouse-y - self.pressed-y)/root.height*300/252*48,-12,12));}}
            double-clicked => {UiData.eq-edit(index,0);}
        }
    }
}
export component EditorWindow inherits Window {
    title: "DualTone · 声音调节";preferred-width: 980px;preferred-height: 896px;min-width: 840px;min-height: 856px;
    default-font-family: "Microsoft YaHei UI";default-font-size: Theme.font;
    in-out property <ColorScheme> scheme <=> Palette.color-scheme;
    Foundation {width: parent.width;height: parent.height;}
    TitleBar {x: 0px;y: 0px;width: parent.width;caption: root.title;maximized: root.maximized;max-hover: UiData.caption-max-hover;command(kind) => {UiData.window-action("editor",kind);}}
    VerticalLayout {y: Theme.caption-height;width: parent.width;height: parent.height - Theme.caption-height;padding: Theme.page-inset;spacing: 14px;
        Row {height: 38px;spacing: 10px;Image {source: UiData.sliders-icon;width: 24px;height: 24px;}Label {text: "声音调节";font-size: 20px;font-weight: 600;horizontal-stretch: 1;}Presets {width: 210px;}Action {text: "管理预设";filled: true;min-width: 86px;clicked => {UiData.action("presets","");}}Action {text: "本机音效";min-width: 78px;clicked => {UiData.action("effects","");}}}
        Surface {height: 82px;
            VerticalLayout {padding: 14px;spacing: 8px;
                Muted {text: UiData.reverb ? "混响 · 副音频只播放尾音" : "空间补充 · 中心声量越低，副音频中居中的人声与乐器越少";height: 16px;}
                Row {height: 36px;spacing: 20px;
                    if !UiData.reverb: ParameterRow {caption: "中心声量";setting: "body";minimum: UiData.minimum-body;value: UiData.body;edited(v) => {UiData.setting("body","\{v}");}}
                    if UiData.reverb: ParameterRow {caption: "空间大小";setting: "reverb_size";value: UiData.reverb-size;edited(v) => {UiData.setting("reverb_size","\{v}");}}
                    if UiData.reverb: ParameterRow {caption: "尾音时长";setting: "reverb_decay";minimum: 0.2;maximum: 4;step: 0.1;unit: "s";value: UiData.reverb-decay;edited(v) => {UiData.setting("reverb_decay","\{round(v*10)/10}");}}
                    if UiData.reverb: ParameterRow {caption: "明暗";setting: "reverb_brightness";value: UiData.reverb-brightness;edited(v) => {UiData.setting("reverb_brightness","\{v}");}}
                }
            }
        }
        Surface {vertical-stretch: 1;
            VerticalLayout {padding: 14px;spacing: 10px;
                Row {height: 26px;spacing: 14px;
                    Legend {caption: "均衡曲线";ink: Theme.curve;}
                    Legend {caption: "过滤后";ink: Theme.filtered;dashed: true;}
                    Legend {caption: "来源频谱";ink: Theme.spectrum;}
                    Legend {caption: "副路频谱";ink: Theme.success;}
                    Rectangle {horizontal-stretch: 1;}
                    Check {text: "均衡器";checked: UiData.eq-on;toggled(v) => {UiData.setting("eq_enabled",v ? "true" : "false");}}
                }
                EqPlot {min-height: 160px;vertical-stretch: 1;}
                Row {height: 24px;Muted {text: "十段均衡 · dB";horizontal-stretch: 1;}Muted {text: UiData.headroom;}Action {text: "增益归零";min-height: 24px;clicked => {UiData.action("eq-reset","");}}}
                Rectangle {height: 62px;
                    for point[index] in UiData.eq-points: VerticalLayout {x: (38/900+point.position*830/900)*parent.width - 32px;width: 64px;spacing: 6px;
                        Muted {text: point.frequency;horizontal-alignment: center;height: 18px;}
                        NumEdit {value: point.value;label: "\{point.frequency} Hz 增益";submitted(v) => {UiData.setting("eq-\{index}",v);}}
                    }
                }
            }
        }
        Surface {height: 148px;
            VerticalLayout {padding: 14px;spacing: 10px;
                Row {height: 28px;spacing: 12px;Check {text: "多段过滤";checked: UiData.band-on;toggled(v) => {UiData.setting("band_enabled",v ? "true" : "false");}}Muted {text: "\{UiData.bands.length} / 8 段";horizontal-stretch: 1;}Action {text: "新增频段";min-height: 28px;enabled: UiData.bands.length<8;clicked => {UiData.action("band-add","");}}}
                ScrollView {vertical-stretch: 1;
                    VerticalLayout {padding: 2px;spacing: 8px;
                        for row[index] in UiData.bands: Row {height: 36px;spacing: 10px;
                            Check {width: 24px;checked: row.enabled;toggled(v) => {UiData.band-edit(index,"enabled",v ? "true" : "false");}}
                            Muted {text: "下限";width: 28px;}NumEdit {value: row.low;unit: "Hz";label: "频段下限";horizontal-stretch: 1;submitted(v) => {UiData.band-edit(index,"low",v);}}
                            Muted {text: "上限";width: 28px;}NumEdit {value: row.high;unit: "Hz";label: "频段上限";horizontal-stretch: 1;submitted(v) => {UiData.band-edit(index,"high",v);}}
                            Muted {text: "增益";width: 28px;}NumEdit {value: row.gain;unit: "dB";label: "频段增益";horizontal-stretch: 1;submitted(v) => {UiData.band-edit(index,"gain_db",v);}}
                            Action {text: "删除";danger: true;min-width: 48px;enabled: UiData.bands.length>1;clicked => {UiData.action("band-delete","\{index}");}}
                        }
                    }
                }
            }
        }
        if UiData.issue!="": Text {text: UiData.issue;color: Theme.danger;font-size: Theme.small;wrap: word-wrap;max-height: 36px;}
        Row {height: 32px;Muted {text: "副路 \{round(UiData.gain*10)/10} % · " + (UiData.reverb ? "混响" : "空间补充");horizontal-stretch: 1;}Action {text: UiData.paused ? "恢复声音" : "静音对比";filled: true;selected: UiData.paused;min-width: 90px;clicked => {UiData.action("pause","");}}}
    }
}
export component InfoWindow inherits Window {
    title: UiData.dialog-title;preferred-width: 520px;preferred-height: UiData.dialog-input ? 306px : UiData.dialog-confirm!="close-info" ? 256px : 376px;min-width: 440px;
    default-font-family: "Microsoft YaHei UI";
    in-out property <ColorScheme> scheme <=> Palette.color-scheme;
    in-out property <string> name;
    Foundation {width: parent.width;height: parent.height;}
    TitleBar {x: 0px;y: 0px;width: parent.width;caption: root.title;maximized: root.maximized;max-hover: UiData.caption-max-hover;command(kind) => {UiData.window-action("info",kind);}}
    VerticalLayout {y: Theme.caption-height;width: parent.width;height: parent.height - Theme.caption-height;padding: 24px;spacing: 16px;
        Label {text: UiData.dialog-title;font-size: 20px;font-weight: 600;height: 30px;}
        if UiData.dialog-confirm!="close-info": Label {text: UiData.dialog-text;wrap: word-wrap;vertical-alignment: top;vertical-stretch: 1;}
        if UiData.dialog-title!="诊断" && UiData.dialog-title!="关于 DualTone" && UiData.dialog-confirm=="close-info": ScrollView {vertical-stretch: 1;Label {text: UiData.dialog-text;wrap: word-wrap;vertical-alignment: top;}}
        if UiData.dialog-title=="诊断": VerticalLayout {spacing: 12px;
            Label {text: UiData.queue;}
            Row {height: 28px;spacing: 10px;Muted {text: "来源";width: 36px;}Meter {level: UiData.input-level;horizontal-stretch: 1;}}
            Row {height: 28px;spacing: 10px;Muted {text: "副音频";width: 36px;}Meter {level: UiData.output-level;horizontal-stretch: 1;}}
            Muted {text: "队列仅反映软件缓冲，不含设备和声学延迟。";wrap: word-wrap;}
            Action {text: "测量数字延迟";min-width: 116px;enabled: UiData.active && !UiData.paused && !UiData.reverb && !UiData.sync-mode;clicked => {UiData.action("latency","");}}
        }
        if UiData.dialog-title=="关于 DualTone": Label {text: UiData.dialog-text;wrap: word-wrap;vertical-alignment: top;vertical-stretch: 1;}
        if UiData.dialog-title=="关于 DualTone": Image {source: @image-url("assets/dualtone-about.png");height: 130px;image-fit: contain;}
        if UiData.dialog-title=="关于 DualTone": AboutSlint {}
        if UiData.dialog-input: Rectangle {height: 38px;background: Theme.field;border-width: 1px;border-color: input.has-focus ? Theme.accent : Theme.line;border-radius: Theme.radius;
            input := TextInput {x: 12px;width: parent.width - 24px;height: parent.height;text <=> root.name;color: Theme.ink;font-family: "Microsoft YaHei UI";font-size: Theme.font;vertical-alignment: center;single-line: true;accessible-label: "预设名称";accepted => {UiData.action(UiData.dialog-confirm,root.name);}}
        }
        Row {height: 36px;Rectangle {horizontal-stretch: 1;}if UiData.dialog-confirm!="close-info": Action {text: "取消";clicked => {UiData.action("close-info","");}}Action {text: UiData.dialog-button;filled: true;danger: UiData.dialog-danger;min-width: 84px;clicked => {UiData.action(UiData.dialog-confirm,root.name);}}}
        if UiData.issue!="": Text {text: UiData.issue;color: Theme.danger;font-size: Theme.small;wrap: word-wrap;max-height: 36px;}
    }
}
export component PresetWindow inherits Window {
    title: "DualTone · 预设";preferred-width: 540px;preferred-height: 456px;min-width: 500px;min-height: 436px;
    default-font-family: "Microsoft YaHei UI";
    in-out property <ColorScheme> scheme <=> Palette.color-scheme;
    Foundation {width: parent.width;height: parent.height;}
    TitleBar {x: 0px;y: 0px;width: parent.width;caption: root.title;maximized: root.maximized;max-hover: UiData.caption-max-hover;command(kind) => {UiData.window-action("presets",kind);}}
    VerticalLayout {y: Theme.caption-height;width: parent.width;height: parent.height - Theme.caption-height;padding: Theme.page-inset;spacing: 16px;
        Row {height: 36px;Label {text: "声音预设";font-size: 20px;font-weight: 600;horizontal-stretch: 1;}Action {text: "新增预设";primary: true;min-width: 90px;clicked => {UiData.action("add-preset","");}}}
        Surface {vertical-stretch: 1;
            VerticalLayout {padding: 16px;spacing: 14px;
                if UiData.presets.length==0: VerticalLayout {spacing: 10px;Label {text: "保存一套自己的声音";font-size: 17px;}Muted {text: "当前的效果、EQ 和频段设置会一起保存。";wrap: word-wrap;}}
                if UiData.presets.length>0: VerticalLayout {spacing: 14px;
                    Picker {model: UiData.presets;current-index: UiData.managed-preset;placeholder: "选择预设";label: "管理预设";selected(v) => {UiData.action("manage-select",v);}}
                    Row {height: 36px;spacing: 8px;Action {text: "载入";filled: true;enabled: UiData.managed-preset>=0;horizontal-stretch: 1;clicked => {UiData.action("manage-load","");}}Action {text: "用当前设置更新";filled: true;enabled: UiData.managed-preset>=0;horizontal-stretch: 1;clicked => {UiData.action("manage-update","");}}}
                    Row {height: 36px;spacing: 8px;Action {text: "重命名";enabled: UiData.managed-preset>=0;horizontal-stretch: 1;clicked => {UiData.action("manage-rename","");}}Action {text: "删除";danger: true;enabled: UiData.managed-preset>=0;horizontal-stretch: 1;clicked => {UiData.action("manage-delete","");}}}
                }
                Rectangle {vertical-stretch: 1;}

            }
        }
        Row {height: 36px;spacing: 8px;Action {text: "导入…";clicked => {UiData.action("import","");}}Action {text: "导出当前…";min-width: 100px;clicked => {UiData.action("export","");}}Rectangle {horizontal-stretch: 1;}Action {text: "完成";filled: true;clicked => {UiData.action("close-presets","");}}}
        if UiData.issue!="": Text {text: UiData.issue;color: Theme.danger;font-size: Theme.small;wrap: word-wrap;max-height: 36px;}
    }
}

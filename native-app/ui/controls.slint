// Native translation of the reference project's layered surfaces and control scale.
import { ScrollView } from "std-widgets.slint";
export global Theme {
    in-out property <bool> dark: true;
    out property <color> foundation: dark ? #181b20 : #e8edf3;
    out property <color> foundation-top: dark ? #273442 : #d8e4ef;
    out property <color> surface: dark ? #262c33 : #f7f9fc;
    out property <color> surface-top: dark ? #303b47 : #ffffff;
    out property <color> field: dark ? #20252c : #ecf1f6;
    out property <color> overlay: dark ? #303740 : #f9fbfe;
    out property <color> ink: dark ? #f2f2f2 : #243342;
    out property <color> muted: dark ? #abb4bf : #5d6f80;
    out property <color> disabled: dark ? #79838e : #8b98a5;
    out property <color> line: dark ? #ffffff19 : #2433421b;
    out property <color> rim: dark ? #b8cde02b : #ffffffd0;
    out property <color> accent: dark ? #a9c7e7 : #3d668c;
    out property <color> selected: dark ? #384c60 : #d5e4f2;
    out property <color> hover: dark ? #ffffff0f : #21395409;
    out property <color> success: dark ? #8accb6 : #24785f;
    out property <color> danger: dark ? #f49aa1 : #a33444;
    out property <color> plot: dark ? #1c2229 : #f1f5f9;
    out property <color> grid: dark ? #333d48 : #d9e2eb;
    out property <color> curve: dark ? #eccb8c : #8d681d;
    out property <color> filtered: dark ? #a9b9d2 : #697994;
    out property <color> spectrum: dark ? #a8b6c6 : #7c8fa4;
    out property <length> radius: 10px;
    out property <length> panel-radius: 14px;
    out property <length> control: 36px;
    out property <length> page-inset: 20px;
    out property <length> panel-inset: 16px;
    out property <length> gap: 12px;
    out property <length> font: 13px;
    out property <length> small: 12px;
    out property <length> caption-height: 36px;
    out property <length> caption-button-width: 46px;
}
export component Row inherits HorizontalLayout { cross-axis-alignment: center; }
export component Label inherits Text {
    color: Theme.ink;font-family: "Microsoft YaHei UI";font-size: Theme.font;
    vertical-alignment: center;overflow: elide;
}
export component Muted inherits Label {color: Theme.muted;font-size: Theme.small;}
export component Foundation inherits Rectangle {
    background: @linear-gradient(135deg, Theme.foundation-top, Theme.foundation 70%);
}
export component Surface inherits Rectangle {
    background: @linear-gradient(135deg, Theme.surface-top, Theme.surface 62%);
    border-radius: Theme.panel-radius;border-width: 1px;border-color: Theme.rim;
    drop-shadow-color: Theme.dark ? #00000022 : #34465a0d;
    drop-shadow-blur: 12px;drop-shadow-offset-y: 4px;
}
export component Divider inherits Rectangle {height: 1px;background: Theme.line;}
export component Action inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> filled: false;
    in property <bool> selected: false;
    in property <bool> primary: false;
    in property <bool> danger: false;
    callback clicked;
    forward-focus: focus;
    accessible-role: button;accessible-label: text;accessible-enabled: enabled;
    min-height: Theme.control;min-width: 80px;horizontal-stretch: 0;vertical-stretch: 0;
    border-radius: Theme.radius;
    background: primary ? Theme.accent : selected ? Theme.selected : touch.has-hover ? Theme.hover : filled ? Theme.field : transparent;
    border-width: focus.has-focus ? 2px : filled || selected ? 1px : 0px;
    border-color: focus.has-focus ? Theme.accent : selected ? Theme.accent.with-alpha(0.35) : Theme.line;
    opacity: enabled ? 1 : 0.4;
    Label {x: 8px;width: parent.width - 16px;height: parent.height;text: root.text;horizontal-alignment: center;
        color: root.primary ? (Theme.dark ? #192939 : white) : root.danger ? Theme.danger : root.selected ? Theme.accent : Theme.ink;}
    focus := FocusScope {enabled: root.enabled;key-pressed(event) => {if event.text==" " || event.text=="\n" {root.clicked();return accept;}return reject;}}
    touch := TouchArea {enabled: root.enabled;mouse-cursor: pointer;clicked => {focus.focus();root.clicked();}}
}
export component Check inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    horizontal-stretch: 0;vertical-stretch: 0;
    min-height: 28px;min-width: text=="" ? 24px : 90px;
    accessible-role: checkbox;accessible-label: text;accessible-checked: checked;
    opacity: enabled ? 1 : 0.4;
    Rectangle {x: 0px;y: (parent.height - 18px)/2;width: 18px;height: 18px;border-radius: 5px;
        background: root.checked ? Theme.accent : Theme.field;border-width: focus.has-focus ? 2px : 1px;border-color: focus.has-focus ? Theme.accent : Theme.line;
        Path {x: 4px;y: 5px;width: 10px;height: 8px;commands: "M 0 3 L 3 6 L 9 0";stroke: root.checked ? (Theme.dark ? #203040 : white) : transparent;stroke-width: 1.8px;}
    }
    Label {x: 26px;width: max(0px,parent.width - 26px);height: parent.height;text: root.text;}
    focus := FocusScope {enabled: root.enabled;key-pressed(event) => {if event.text==" " {root.toggled(!root.checked);return accept;}return reject;}}
    TouchArea {enabled: root.enabled;mouse-cursor: pointer;clicked => {focus.focus();root.toggled(!root.checked);}}
}
export component Fader inherits Rectangle {
    in property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <string> label;
    callback edited(float);
    height: 32px;accessible-role: slider;accessible-label: label;accessible-value: "\{value}";
    Rectangle {x: 8px;y: 14px;width: parent.width - 16px;height: 4px;border-radius: 2px;background: Theme.line;
        Rectangle {x: 0px;y: 0px;width: parent.width * clamp((root.value - root.minimum)/(root.maximum - root.minimum),0,1);height: 4px;border-radius: 2px;background: Theme.accent;}
    }
    Rectangle {x: 8px+(root.width - 16px)*clamp((root.value - root.minimum)/(root.maximum - root.minimum),0,1) - 7px;y: 9px;width: 14px;height: 14px;border-radius: 7px;
        background: Theme.dark ? #eef3f8 : #ffffff;border-width: key.has-focus ? 3px : 1px;border-color: key.has-focus ? Theme.accent : Theme.muted;
        drop-shadow-color: #00000030;drop-shadow-blur: 3px;drop-shadow-offset-y: 1px;
    }
    key := FocusScope {key-pressed(event) => {if event.text==Key.LeftArrow || event.text==Key.DownArrow {root.edited(max(root.minimum,root.value - root.step));return accept;}if event.text==Key.RightArrow || event.text==Key.UpArrow {root.edited(min(root.maximum,root.value+root.step));return accept;}return reject;}}
    touch := TouchArea {mouse-cursor: pointer;
        function update() {root.edited(root.minimum+clamp((self.mouse-x - 8px)/(self.width - 16px),0,1)*(root.maximum - root.minimum));}
        pointer-event(event) => {if event.kind==PointerEventKind.down {key.focus();self.update();}}
        moved => {if self.pressed {self.update();}}
    }
}
export component NumEdit inherits Rectangle {
    in property <string> value;
    in property <string> label;
    in property <string> unit;
    callback submitted(string);
    changed value => {input.text=root.value;}
    min-height: Theme.control;background: Theme.field;border-radius: Theme.radius;
    border-width: 1px;border-color: input.has-focus ? Theme.accent : Theme.line;
    input := TextInput {x: 10px;width: parent.width - (root.unit=="" ? 20px : 42px);height: parent.height;
        text: root.value;color: Theme.ink;font-family: "Microsoft YaHei UI";font-size: Theme.font;
        horizontal-alignment: right;vertical-alignment: center;single-line: true;accessible-label: root.label;
        accepted => {root.submitted(self.text);self.text=root.value;}
        changed has-focus => {if !self.has-focus && self.text!=root.value {root.submitted(self.text);self.text=root.value;}}
    }
    if root.unit!="": Muted {x: parent.width - 28px;width: 22px;height: parent.height;text: root.unit;}
}
export component Picker inherits Rectangle {
    in property <[string]> model;
    in property <int> current-index: -1;
    in property <string> placeholder: "选择设备";
    in property <bool> enabled: true;
    in property <string> label: "选择";
    callback selected(string);
    private property <int> cursor: 0;
    height: Theme.control;horizontal-stretch: 1;vertical-stretch: 0;
    background: touch.has-hover && enabled ? Theme.hover : Theme.field;
    border-width: 1px;border-color: focus.has-focus ? Theme.accent : Theme.line;border-radius: Theme.radius;opacity: enabled ? 1 : 0.45;
    forward-focus: focus;
    accessible-role: combobox;accessible-label: label;
    public function open() {if root.enabled && root.model.length>0 {root.cursor=max(0,root.current-index);popup.show();}}
    Label {x: 12px;width: parent.width - 40px;height: parent.height;text: root.current-index>=0 && root.current-index<root.model.length ? root.model[root.current-index] : root.placeholder;}
    Path {x: parent.width - 23px;y: parent.height/2 - 2px;width: 8px;height: 4px;commands: "M 0 0 L 4 4 L 8 0";stroke: Theme.muted;stroke-width: 1.4px;}
    focus := FocusScope {enabled: root.enabled;key-pressed(event) => {if event.text==" " || event.text=="\n" || event.text==Key.DownArrow {root.open();return accept;}return reject;}}
    touch := TouchArea {enabled: root.enabled;mouse-cursor: pointer;clicked => {focus.focus();root.open();}}
    popup := PopupWindow {forward-focus: popup-focus;y: root.height+6px;width: root.width;height: min(300px,root.model.length*36px+12px);
        Rectangle {width: parent.width;height: parent.height;background: Theme.overlay;border-width: 1px;border-color: Theme.rim;border-radius: Theme.radius;}
        popup-focus := FocusScope {key-pressed(event) => {
            if event.text==Key.Escape {popup.close();focus.focus();return accept;}
            if event.text=="\n" || event.text==" " {root.selected(root.model[root.cursor]);popup.close();focus.focus();return accept;}
            if event.text==Key.DownArrow {root.cursor=min(root.model.length - 1,root.cursor+1);list.content-y=-max(0px,root.cursor*36px-list.height+36px);return accept;}
            if event.text==Key.UpArrow {root.cursor=max(0,root.cursor - 1);list.content-y=-min(root.cursor*36px,-list.content-y);return accept;}
            return reject;
        }}
        list := ScrollView {x: 6px;y: 6px;width: parent.width - 12px;height: parent.height - 12px;
            VerticalLayout {spacing: 0px;
                for item[index] in root.model: Rectangle {height: 36px;border-radius: 6px;background: index==root.cursor ? Theme.selected : hit.has-hover ? Theme.hover : transparent;
                    Label {x: 10px;width: parent.width - 32px;height: parent.height;text: item;color: index==root.current-index ? Theme.accent : Theme.ink;}
                    if index==root.current-index: Rectangle {x: parent.width - 18px;y: 15px;width: 6px;height: 6px;border-radius: 3px;background: Theme.accent;}
                    hit := TouchArea {mouse-cursor: pointer;clicked => {root.selected(item);popup.close();focus.focus();}}
                }
            }
        }
    }
}
export component Meter inherits Rectangle {
    in property <float> level;height: 3px;border-radius: 2px;background: Theme.line;
    Rectangle {x: 0px;y: 0px;width: parent.width*clamp(root.level,0,1);height: parent.height;border-radius: 2px;background: Theme.success;}
}

// Native hit testing owns drag, resize and the Windows 11 maximize flyout.
export component CaptionButton inherits Rectangle {
    in property <string> kind;
    in property <bool> minimize-to-tray;
    in property <bool> maximized;
    in property <bool> native-hover;
    callback invoked;
    width: Theme.caption-button-width;height: Theme.caption-height;
    accessible-role: button;accessible-label: kind=="close" ? "关闭" : kind=="minimize" ? (minimize-to-tray ? "最小化到托盘" : "最小化") : maximized ? "还原" : "最大化";
    background: touch.has-hover || native-hover ? (kind=="close" ? #c84b55 : Theme.hover) : transparent;
    Path {x: (parent.width - 10px)/2;y: (parent.height - 10px)/2;width: 10px;height: 10px;
        commands: root.kind=="close" ? "M 0 0 L 10 10 M 0 10 L 10 0" : root.kind=="minimize" ? "M 0 5 L 10 5" : root.maximized ? "M 2 0 L 10 0 L 10 8 M 0 2 L 8 2 L 8 10 L 0 10 Z" : "M 0 0 L 10 0 L 10 10 L 0 10 Z";
        stroke: root.kind=="close" && touch.has-hover ? white : Theme.muted;stroke-width: 1.2px;
    }
    focus := FocusScope {key-pressed(event) => {if event.text==" " || event.text=="\n" {root.invoked();return accept;}return reject;}}
    Rectangle {x: 4px;y: 4px;width: parent.width - 8px;height: parent.height - 8px;border-radius: 5px;border-width: focus.has-focus ? 1px : 0px;border-color: Theme.accent;}
    touch := TouchArea {clicked => {focus.focus();root.invoked();}}
}
export component TitleBar inherits Rectangle {
    in property <string> caption;
    in property <bool> minimize-to-tray;
    in property <bool> maximized;
    in property <bool> max-hover;
    callback command(string);
    height: Theme.caption-height;
    Muted {x: 20px;width: parent.width - 3*Theme.caption-button-width - 30px;height: parent.height;text: root.caption;}
    Row {x: parent.width - 3*Theme.caption-button-width;width: 3*Theme.caption-button-width;height: parent.height;spacing: 0px;
        CaptionButton {kind: "minimize";minimize-to-tray: root.minimize-to-tray;invoked => {root.command("minimize");}}
        CaptionButton {kind: "maximize";maximized: root.maximized;native-hover: root.max-hover;invoked => {root.command("maximize");}}
        CaptionButton {kind: "close";invoked => {root.command("close");}}
    }
}
